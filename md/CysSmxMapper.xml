    <sql id="selectCysSmxVo">
        select doublesided_id, dsm_code, workorder_id, workorder_code, brand, batch_number, milling_count, sp_before_milling, sp_after_milling, sp_before_weight, sp_after_weight, milling_time, user_id, user_name, quality_judgment, abnormal_cause, remark, create_by, create_time, update_by, update_time from cys_smx
