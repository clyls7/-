    <select id="selectCysSmxList" parameterType="CysSmx" resultMap="CysSmxResult">
        <include refid="selectCysSmxVo"/>
        <where>  
            <if test="dsmCode != null  and dsmCode != ''"> and dsm_code = #{dsmCode}</if>
            <if test="workorderId != null "> and workorder_id = #{workorderId}</if>
