    <select id="selectCysScgdList" parameterType="CysScgd" resultMap="CysScgdResult">
        <include refid="selectCysScgdVo"/>
        <where>
            <if test="workCode != null and workCode != ''"> and work_code = #{workCode}</if>
            <if test="porderCode != null and porderCode != ''"> and porder_code = #{porderCode}</if>
            <if test="porderName != null and porderName != ''"> and porder_name like concat('%', #{porderName}, '%')</if>
            <if test="submitTime != null"> and submit_time = #{submitTime}</if>
            <if test="workStatus != null and workStatus != ''"> and work_status = #{workStatus}</if>
            <if test="allocationStatus != null and allocationStatus != ''"> and allocation_status = #{allocationStatus}</if>

            <!-- 新增多工序列表查询 -->
            <if test="thisProcessList != null and thisProcessList.size > 0">
                and this_process in
                <foreach collection="thisProcessList" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>

            <!-- 保留单个工序查询，避免冲突 -->
            <if test="thisProcess != null and thisProcess != ''">
                and this_process = #{thisProcess}
            </if>

            <if test="startTime != null"> and start_time = #{startTime}</if>
            <if test="endTime != null"> and end_time = #{endTime}</if>
            <if test="brand != null and brand != ''"> and brand = #{brand}</if>
            <if test="batchNumber != null and batchNumber != ''"> and batch_number = #{batchNumber}</if>
            <if test="plannedOrdersCode != null and plannedOrdersCode != ''"> and planned_orders_code = #{plannedOrdersCode}</if>
